# Supabase project
SUPABASE_PROJECT_REF=your-project-ref          # Found in Supabase Dashboard → Settings → General

# Edge Function secret (generate with: openssl rand -hex 32)
INGEST_API_KEY=your-api-key-here

# Google Ads Script config (these are NOT env vars — paste them into the script's CONFIG section)
# EDGE_FUNCTION_URL = https://your-project-ref.supabase.co/functions/v1/ingest
# INGEST_API_KEY    = same key as above
# CUSTOMER_ID       = 123-456-7890  (Google Ads CID with dashes, found in Google Ads top right)
